# Tooling and environments
.venv/
__pycache__/
*.blend1

# Game data, extracted locally from the player's own install (tools/export_game_data.sh); never committed
extracted/

# Per vehicle: build output (tools/build_vehicle.py) and parts generated from extracted game data
vehicles/*/build/
vehicles/*/generated/
# Icons traced from the game's own Mammoth icon (tools/trace_icons.py), built locally
vehicles/mastodon/icon.png
vehicles/mastodon/icon.svg
vehicles/megatherium/icon.png
vehicles/megatherium/icon.svg

# The workshop loop's per-change summary (`make loop`); `make pr` puts it in the pull request
vehicles/*/contact/CHANGES.md
vehicles/.old-contact.json

# Build output and local captures
dist/
plugins/*/bin/
plugins/*/obj/
renders/
logs/
tools/near-plan/bin/
tools/near-plan/obj/

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VehicleMods</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Reproducible: the same sources give the same DLL wherever the repo is cloned. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/werkstatt/VehicleMods</PathMap>
    <!-- The game folder: pass -p:GameDir=<path> or set GameDir in the environment when the game
         isn't in Steam's default library. -->
    <GameDir Condition="'$(GameDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/over the hill</GameDir>
    <BepInExDir>$(GameDir)/BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Unity.Addressables.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Fusion.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Funselektor.FunCore.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/Unity.Localization.dll" Private="false" />
  </ItemGroup>

  <!-- The files a deploy copies, from each vehicle folder ../../vehicles/<name>/: its vehicle.json as
       vehicles/<name>.json, the meshes tools/build_vehicle.py wrote to build/ as vehicles/<name>/*.obj,
       and its icon.png as icons/<Codename>.png (the codename read from vehicle.json). -->
  <UsingTask TaskName="VehicleDeployFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <VehiclesDir ParameterType="System.String" Required="true" />
      <DeployDir ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var files = new System.Collections.Generic.List<ITaskItem>();
        void Add(string source, string destination)
        {
            var item = new TaskItem(source);
            item.SetMetadata("Destination", destination);
            files.Add(item);
        }
        foreach (var folder in Directory.GetDirectories(VehiclesDir))
        {
            var manifest = Path.Combine(folder, "vehicle.json");
            if (!File.Exists(manifest)) continue;
            var name = Path.GetFileName(folder);
            Add(manifest, Path.Combine(DeployDir, "vehicles", name + ".json"));
            var build = Path.Combine(folder, "build");
            if (Directory.Exists(build))
                foreach (var obj in Directory.GetFiles(build, "*.obj"))
                    Add(obj, Path.Combine(DeployDir, "vehicles", name, Path.GetFileName(obj)));
            var icon = Path.Combine(folder, "icon.png");
            var codename = Regex.Match(File.ReadAllText(manifest), "\"codename\"\\s*:\\s*\"([^\"]+)\"").Groups[1].Value;
            if (File.Exists(icon) && codename.Length > 0)
                Add(icon, Path.Combine(DeployDir, "icons", codename + ".png"));
        }
        Files = files.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Deploys the DLL and the vehicle files above to BepInEx/plugins/VehicleMods/ (or -p:DeployDir=<dir>).
       Pass -p:Deploy=false to compile without deploying. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <PropertyGroup>
      <DeployDir Condition="'$(DeployDir)' == ''">$(BepInExDir)/plugins/VehicleMods</DeployDir>
    </PropertyGroup>
    <VehicleDeployFiles VehiclesDir="$(MSBuildProjectDirectory)/../../vehicles" DeployDir="$(DeployDir)">
      <Output TaskParameter="Files" ItemName="VehicleFiles" />
    </VehicleDeployFiles>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="@(VehicleFiles)" DestinationFiles="@(VehicleFiles->'%(Destination)')" />
  </Target>

</Project>

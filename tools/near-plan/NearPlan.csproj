<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the plugin's hook-page placement: feeds captured /proc/self/maps layouts to the same
       NearBlockPlanner the plugin runs. `make check` runs it over tests/maps/*.maps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugins/VehicleMods/NearBlockPlanner.cs" />
  </ItemGroup>
</Project>

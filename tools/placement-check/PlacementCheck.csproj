<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the plugin's placements reader and composition: resolves tests/placements/fixture.json
       with the same PlacementPlan the plugin runs and compares it with expect.json, which the Blender add-on's
       model is tested against too (tests/test_placements.py). `make check` runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugins/VehicleMods/PlacementPlan.cs" />
  </ItemGroup>
</Project>

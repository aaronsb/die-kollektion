<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of Kollektion.Core's game-data layer (GameData/): Pillow-rounding BC1/BC3, PNG, Pillow's
       polygon fill, mesh decoding, and numbers and JSON as Python writes them, against values taken from CPython and
       Pillow. Needs no game files; `python3 tools/release.py ci` runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kollektion.Core/Kollektion.Core.csproj" />
  </ItemGroup>
</Project>

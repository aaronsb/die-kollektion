<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of Core's vehicle build (src/Kollektion.Core/Build/) against what tools/build_vehicle.py and
       tools/meshlib.py make of synthetic meshes, and of its Python number semantics (tests/meshops/, written by
       tests/meshops/make_fixtures.py). `python3 tools/release.py ci` runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kollektion.Core/Kollektion.Core.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the plugin and `kollektion` must agree on (docs/vehicle_factory.md, Architecture). net6.0 with no BepInEx
       or IL2CPP references, so the plugin can share it; per-OS differences live here and nowhere else. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=Kollektion.Core</PathMap>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bundle reader under GameData/ (docs/vehicle_factory.md, Architecture: the donor reader): MIT, managed,
         netstandard2.0, no dependencies, so the plugin can load it too. Pinned to the exact version. -->
    <PackageReference Include="AssetsTools.NET" Version="[3.0.5]" />
  </ItemGroup>
</Project>

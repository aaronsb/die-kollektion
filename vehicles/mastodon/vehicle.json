{
  "codename": "Mastodon",
  "displayName": "Das Mastodon",
  "description": "Das Mastodon is what happens when the long frame stays and the back seat goes. One bench, two doors, a full-length bed, and a cab just roomy enough for a driver, a thermos and an opinion. It has never once been asked to carry passengers, and it intends to keep it that way.",
  "listing": {
    "family": "Mammoth",
    "variant": "two-door, long wheelbase",
